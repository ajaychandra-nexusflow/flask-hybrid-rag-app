# ---- App ----
APP_NAME=Hybrid RAG Assistant
APP_TAGLINE=Ask questions about your documents
HOST=0.0.0.0
PORT=5050
DEBUG=false
SECRET_KEY=change-me
MAX_UPLOAD_MB=20

# ---- AWS / Bedrock ----
# Leave the keys blank to use the default AWS credential chain (profile, SSO, role).
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024
EMBED_WORKERS=4
MAX_TOKENS=1024
TEMPERATURE=0.2

# ---- ChromaDB ----
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=documents

# ---- Chunking and hybrid retrieval ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
HYBRID_DENSE_WEIGHT=0.6
HYBRID_KEYWORD_WEIGHT=0.4
RRF_K=60

# ---- Assistant behaviour ----
SYSTEM_PROMPT=You are a precise assistant. Answer using only the numbered context passages provided. Cite sources inline like [1] or [2]. If the context does not contain the answer, say you could not find it in the documents. Keep answers clear and concise.
